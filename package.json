{
  "name": "pescamigos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:integration": "npm run test:e2e:prepare && vitest run --config vitest.integration.config.ts --configLoader runner",
    "test:e2e:prepare": "tsx scripts/e2e-prepare.ts",
    "test:e2e": "npm run test:e2e:prepare && tsx scripts/run-e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "argon2": "latest",
    "clsx": "latest",
    "leaflet": "latest",
    "lucide-react": "latest",
    "next": "16.3.0",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.35.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/react": "latest",
    "@types/leaflet": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.25",
    "prettier": "latest",
    "prisma": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
